# Copy this file to .env and fill in values as they become available.
# Nothing here is required to run the current pipeline (Telco dataset only) —
# these are only needed once the integrations below are switched on.

# ---- Company site API (NOT YET ACTIVE) ----
COMPANY_API_BASE_URL=
COMPANY_API_KEY=

# ---- Existing customer agent (NOT YET ACTIVE) ----
AGENT_API_BASE_URL=
AGENT_API_KEY=

# ---- DummyJSON sandbox (public, no key required) ----
DUMMYJSON_BASE_URL=https://dummyjson.com

# ---- Amazon SQS Tracking Queue ----
TRACKING_QUEUE_URL=
TRACKING_QUEUE_NAME=ai-pod-tracking-events
AWS_REGION=us-east-1

