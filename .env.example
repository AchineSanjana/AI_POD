# Copy this file to .env and fill in values as they become available.
# Nothing here is required to run the current pipeline (Telco dataset only) —
# these are only needed once the integrations below are switched on.

# ---- Environment & Authentication ----
ENV=development
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# ---- CORS Allowed Origins ----
# Comma-separated list of origins permitted to access APIs from web browsers.
# When omitted, defaults to local dev servers on ports 5173 and 5500.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# ---- SMTP Email Verification ----
# Configure your outgoing mail server to send real verification codes.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your_email@gmail.com, SMTP_PASS=app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_SSL=false
ENFORCE_EMAIL_VERIFICATION=false

# ---- Company site API (NOT YET ACTIVE) ----
COMPANY_API_BASE_URL=
COMPANY_API_KEY=

# ---- Existing customer agent (NOT YET ACTIVE) ----
AGENT_API_BASE_URL=
AGENT_API_KEY=

# ---- DummyJSON sandbox (public, no key required) ----
DUMMYJSON_BASE_URL=https://dummyjson.com

# ---- Amazon SQS Tracking Queue ----
TRACKING_QUEUE_URL=
TRACKING_QUEUE_NAME=ai-pod-tracking-events
AWS_REGION=us-east-1
